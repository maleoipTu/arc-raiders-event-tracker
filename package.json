{
  "name": "arc-raiders-event-tracker",
  "version": "0.5.0",
  "private": true,
  "description": "Desktop event tracker for ARC Raiders",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable",
    "installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "local.arcraiders.eventtracker",
    "productName": "ARC Event Tracker",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "THIRD_PARTY_NOTICES.md",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ARC Event Tracker",
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "artifactName": "ARC-Event-Tracker-Setup-${version}.${ext}"
    }
  }
}
