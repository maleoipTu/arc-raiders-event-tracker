{
  "name": "arc-raiders-event-tracker",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "description": "Desktop event tracker for ARC Raiders",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable",
    "installer": "electron-builder --win nsis --publish never",
    "publish": "electron-builder --win nsis --publish always",
    "android:prepare": "node scripts/build-mobile.mjs && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:apk": "node scripts/build-mobile.mjs && node node_modules/@capacitor/cli/bin/capacitor sync android && node scripts/build-android.mjs",
    "android:signing": "node scripts/prepare-android-signing.mjs",
    "android:test": "node --test tests/mobile.test.mjs",
    "quests:test": "node --test tests/quest-graph.test.cjs",
    "game:test": "node --test tests/game-model.test.cjs tests/arc-sources.test.mjs",
    "game:sync": "node scripts/sync-game.mjs --refresh"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "local.arcraiders.eventtracker",
    "productName": "ARC Event Tracker",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "quest-graph.js",
      "game-model.js",
      "map-ui.js",
      "map-ui.css",
      "book-ui.js",
      "book-ui.css",
      "THIRD_PARTY_NOTICES.md",
      "LICENSE",
      "CODE_SIGNING_POLICY.md",
      "PRIVACY.md",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "maleoipTu",
        "repo": "arc-raiders-event-tracker",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ARC Event Tracker",
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "artifactName": "ARC-Event-Tracker-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "electron-updater": "^6.8.11"
  }
}
